**UserList.cshtml**

```razor
@model IEnumerable<UserRegistrationApp.Models.User>
@{
    ViewData["Title"] = "Registered Users";
}
<h2>Registered Users</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Gender</th>
            <th>Age</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.Gender</td>
                <td>@user.Age</td>
            </tr>
        }
    </tbody>
</table>
